

pipeline {
    agent any
    
    tools {
        nodejs 'nodejs23'
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'
    }
    stages {
        stage('Git Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/Priyanka4pq/3-tier-DevSecOps.git'
            }
        }
        
        stage('Frontend Compilation') {
            steps {
                dir('client') {
                    sh 'find . -name "*.js" -exec node --check {} +'
                }
            }
        }
        
        stage('Backend Compilation') {
            steps {
                dir('api') {
                    sh 'find . -name "*.js" -exec node --check {} +'
                }
            }
        }
        
        stage('GitLeaks Scan') {
            steps {
                sh 'gitleaks detect --source ./client --report-format json --report-path gitleaks-client-report.json --exit-code 1 || true'
                sh 'gitleaks detect --source ./api --report-format json --report-path gitleaks-api-report.json --exit-code 1 || true'
                archiveArtifacts artifacts: 'gitleaks-*-report.json', allowEmptyArchive: true
            }
        }
        
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar') {
                    sh ''' $SCANNER_HOME/bin/sonar-scanner -Dsonar.projectName=NodeJS-Project \
                            -Dsonar.projectKey=NodeJS-Project '''
                }
            }
        }
        stage('Quality Gate Check') {
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    waitForQualityGate abortPipeline: false, credentialsId: 'sonar-token'
                }
            }
        }
        stage('Trivy FS Scan') {
            steps {
                sh 'trivy fs --format table -o fs-report.html .'
            }
        }
        
        stage('Build-Tag & Push Backend Docker Image') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker-cred') {
                        dir('api') {
                            sh 'docker build -t priyanka4pq/backend:latest .'
                            sh 'trivy image --format table -o backend-image-report.html priyanka4pq/backend:latest '
                            sh 'docker push priyanka4pq/backend:latest'
                           
                        }
                    }
                }
            }
        }  
            
        stage('Build-Tag & Push Frontend Docker Image') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker-cred') {
                        dir('client') {
                            sh 'docker build -t priyanka4pq/frontend:latest .'
                            sh 'trivy image --format table -o frontend-image-report.html priyanka4pq/frontend:latest '
                            sh 'docker push priyanka4pq/frontend:latest'
                        }
                    }
                }
            }
             
        }  
        
        stage('Manual Approval'){
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    input message: 'Approve deployment to production?', ok: 'Deploy'
                }
            }
        }
        
        stage('Deployment to Prod') {
            steps {
                script {
                    withKubeConfig(caCertificate: '', clusterName: 'devopsshack-cluster', contextName: '', credentialsId: 'k8s-prod-token', namespace: 'prod', restrictKubeConfigAccess: false, serverUrl: 'https://E10D11DAD9D16E7A834DBBE488050A3E.gr7.ap-south-1.eks.amazonaws.com') {
                        sh 'kubectl apply -f k8s-prod/StorageClass.yaml'
                        sleep 20
                        sh 'kubectl apply -f k8s-prod/mysql.yaml -n prod'
                        sh 'kubectl apply -f k8s-prod/backend.yaml -n prod'
                        sh 'kubectl apply -f k8s-prod/ci.yaml'
                        sh 'kubectl apply -f k8s-prod/frontend.yaml -n prod'
                        sh 'kubectl apply -f k8s-prod/ingress.yaml -n prod'
                        sleep 30
                    }
                }
            }
        }
        
        stage('Verify Deployment to Prod') {
            steps {
                script {
                    withKubeConfig(caCertificate: '', clusterName: 'devopsshack-cluster', contextName: '', credentialsId: 'k8s-prod-token', namespace: 'prod', restrictKubeConfigAccess: false, serverUrl: 'https://E10D11DAD9D16E7A834DBBE488050A3E.gr7.ap-south-1.eks.amazonaws.com') {
                        sh 'kubectl get pods -n prod'
                        sleep 20
                        sh 'kubectl get ingress -n prod' 
                    }
                }
            }
        }
            
    }
}
